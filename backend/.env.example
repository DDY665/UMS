PORT=3000
NODE_ENV=development

# Use a long random string in local/dev and a secure secret in production
JWT_SECRET=replace_with_your_secure_jwt_secret

# Comma-separated allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://username:password@localhost:3306/mydb

# SMTP / Gmail app password config
MAIL_USER=you@example.com
MAIL_PASS=replace_with_mail_app_password

# Frontend URL used in onboarding email links
FRONTEND_URL=http://localhost:5173
